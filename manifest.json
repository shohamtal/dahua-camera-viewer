{
  "manifest_version": 3,
  "name": "Dahua Camera Viewer",
  "version": "1.0.0",
  "description": "Plugin-free viewer for Dahua NVR/DVR/IP cameras: live MJPEG + recordings, directly over your LAN. No server required.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open Dahua Camera Viewer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
